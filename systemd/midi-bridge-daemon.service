[Unit]
Description=MIDI bridge daemon

[Service]
Type=simple
WorkingDirectory=%h/.local/share/midi-bridge-daemon
ExecStart=/usr/bin/python3 -m midi_bridge_daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
